---
import Base from '../layouts/Base.astro';

const UTM = '?utm_source=sigmentum&utm_medium=astro_landing&utm_campaign=organic';
const APP = 'https://kennethleeventura.github.io/SIGMENTUM/';

const siteUrl     = (Astro.site?.href ?? 'https://kennethleeventura.github.io/SIGMENTUM').replace(/\/$/, '');
const title       = 'Sigmentum — Where signals meet momentum';
const description = 'AI-powered trading signals every 15 minutes across 50+ assets. Backtest strategies with the Hindsight Sandbox, paper trade with a $10k wallet, and automate execution. Free to start.';
const canonical   = siteUrl;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Sigmentum',
      url: siteUrl,
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Web',
      description: 'AI-powered automated trading signal platform with real-time alerts, Hindsight Sandbox backtesting, and auto-execution agents for gold, crypto, forex, and equities.',
      offers: [
        { '@type': 'Offer', name: 'Free',     price: '0',  priceCurrency: 'USD', priceSpecification: { '@type': 'UnitPriceSpecification', billingDuration: 'P1M' } },
        { '@type': 'Offer', name: 'Signal',   price: '28', priceCurrency: 'USD', priceSpecification: { '@type': 'UnitPriceSpecification', billingDuration: 'P1M' } },
        { '@type': 'Offer', name: 'Momentum', price: '82', priceCurrency: 'USD', priceSpecification: { '@type': 'UnitPriceSpecification', billingDuration: 'P1M' } },
      ],
      featureList: [
        'AI-generated trading signals every 15 minutes',
        'Hindsight Sandbox backtesting (2 years of data)',
        '$10,000 paper trading wallet',
        'Automated execution agent',
        'Telegram and email alerts',
        'Copy-agent marketplace',
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is the Hindsight Sandbox?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The Hindsight Sandbox lets you backtest any trading strategy against up to 2 years of real historical price data. Select an asset and rule, run the backtest, and see win rate, net P&L, max drawdown, and monthly returns — for free, before risking any capital.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does the Execution Agent work?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The Execution Agent monitors markets in real-time using your configured rules. When a trigger condition is met (e.g. 85% AI confidence), it sends an alert via Telegram, email, or SMS — or executes the trade automatically via your connected broker API on the Momentum tier.',
          },
        },
        {
          '@type': 'Question',
          name: 'Is Sigmentum free to use?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. The Free tier includes 5 signals per day, a $10,000 simulated paper trading wallet, and 3 Hindsight Sandbox backtests per month — no credit card required.',
          },
        },
      ],
    },
  ],
};
---
<Base title={title} description={description} canonical={canonical} schema={schema}>

  <!-- ── HERO ──────────────────────────────────────────────────────────── -->
  <section style="padding: 96px 0 80px; text-align: center; position: relative;">
    <div class="container" style="max-width: 820px;">

      <div class="eyebrow" style="margin-bottom: 20px; color: var(--orange);">
        AI Trading Signals · 50+ Assets · Every 15 Minutes
      </div>

      <h1 class="serif" style="font-size: clamp(40px, 7vw, 72px); font-weight: 700; margin: 0 0 24px; letter-spacing: -0.025em; line-height: 1.1; color: var(--ink);">
        Where signals meet<br/>momentum
      </h1>

      <p style="font-size: clamp(16px, 2.5vw, 20px); color: var(--ink-3); max-width: 580px; margin: 0 auto 40px; line-height: 1.65;">
        Sigmentum delivers AI-ranked trading signals for gold, crypto, forex, and equities — with a built-in backtester, a $10k paper wallet, and auto-execution agents. Free to start.
      </p>

      <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
        <a href={`${APP}${UTM}&utm_content=hero_start_free`}
           style="display: inline-flex; align-items: center; gap: 8px; background: var(--orange); color: white; padding: 14px 28px; border-radius: 999px; font-size: 15px; font-weight: 600; text-decoration: none; box-shadow: 0 4px 16px rgba(238,106,19,0.35); transition: all 200ms;">
          Start free — no card needed →
        </a>
        <a href="#how-it-works"
           style="display: inline-flex; align-items: center; gap: 8px; background: white; color: var(--ink); padding: 14px 28px; border-radius: 999px; font-size: 15px; font-weight: 500; text-decoration: none; border: 1px solid var(--line-strong); transition: all 200ms;">
          See how it works
        </a>
      </div>

      <!-- Signal preview card -->
      <div class="glass" style="max-width: 540px; margin: 56px auto 0; padding: 20px 24px; text-align: left;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
          <div>
            <div class="eyebrow" style="font-size: 10px; color: var(--ink-5); margin-bottom: 4px;">LATEST SIGNAL</div>
            <div style="font-size: 17px; font-weight: 700; color: var(--ink);">XAU/USD · Gold</div>
          </div>
          <span style="background: rgba(15,184,100,0.12); color: var(--green); font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 999px; font-family: var(--font-mono);">LONG</span>
        </div>
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 14px;">
          {[
            { label: 'Confidence', value: '91%' },
            { label: 'Entry',      value: '2,341' },
            { label: 'TP1',        value: '2,358' },
            { label: 'Stop',       value: '2,328' },
          ].map(({ label, value }) => (
            <div>
              <div style="font-size: 10px; color: var(--ink-5); margin-bottom: 3px; font-family: var(--font-mono); letter-spacing: 0.08em;">{label}</div>
              <div class="mono" style="font-size: 14px; font-weight: 600; color: var(--ink);">{value}</div>
            </div>
          ))}
        </div>
        <div style="font-size: 12px; color: var(--ink-4); line-height: 1.5; border-top: 1px solid var(--line); padding-top: 12px;">
          <span style="color: var(--orange); font-weight: 600;">AI reasoning:</span> EMA-9 crossed above EMA-21 at London open with RSI-14 at 58 — momentum confirmed. Volatility regime normal. R:R 1.8:1.
        </div>
      </div>

    </div>
  </section>

  <!-- ── HOW IT WORKS ──────────────────────────────────────────────────── -->
  <section id="how-it-works" style="padding: 80px 0;">
    <div class="container">

      <div style="text-align: center; margin-bottom: 56px;">
        <div class="eyebrow" style="margin-bottom: 12px;">How it works</div>
        <h2 class="serif" style="font-size: clamp(28px, 4vw, 42px); font-weight: 700; margin: 0; letter-spacing: -0.02em; color: var(--ink);">
          From signal to trade in seconds
        </h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
        {[
          {
            step: '01',
            title: 'AI scans 50+ markets',
            body: 'Every 15 minutes, Sigmentum evaluates EMA crossovers, RSI divergences, volatility regimes, and event risk across crypto, forex, gold, and equities.',
          },
          {
            step: '02',
            title: 'Signals are ranked by confidence',
            body: 'Each signal gets a confidence score from 0–100 based on how many inputs align. You see the full AI reasoning — no black box.',
          },
          {
            step: '03',
            title: 'You act — or the agent does',
            body: 'Paper trade with a $10k wallet on Free. Set Telegram alerts on Signal. Let the Execution Agent place orders automatically on Momentum.',
          },
        ].map(({ step, title, body }) => (
          <div class="glass" style="padding: 28px 30px;">
            <div class="mono" style="font-size: 12px; color: var(--orange); margin-bottom: 14px; font-weight: 600;">{step}</div>
            <h3 style="font-size: 17px; font-weight: 700; color: var(--ink); margin: 0 0 10px;">{title}</h3>
            <p style="font-size: 14px; color: var(--ink-3); line-height: 1.65; margin: 0;">{body}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ── FEATURES ──────────────────────────────────────────────────────── -->
  <section id="features" style="padding: 80px 0; background: rgba(11,13,18,0.02);">
    <div class="container">

      <div style="text-align: center; margin-bottom: 56px;">
        <div class="eyebrow" style="margin-bottom: 12px;">Platform features</div>
        <h2 class="serif" style="font-size: clamp(28px, 4vw, 42px); font-weight: 700; margin: 0; letter-spacing: -0.02em; color: var(--ink);">
          Everything you need to trade with an edge
        </h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
        {[
          {
            icon: '⚡',
            title: 'Real-time signal feed',
            body: 'Signals fire every 15 minutes across XAU/USD, BTC, ETH, EUR/USD, GBP/USD, SPY, TSLA, and 40+ more. Each shows entry, TP1, TP2, stop-loss, and the full AI reasoning chain.',
          },
          {
            icon: '🧪',
            title: 'Hindsight Sandbox',
            body: 'Select any asset and strategy rule, run a backtest against 2 years of real price data, and see win rate, net P&L, max drawdown, and month-by-month returns — before risking a dollar.',
          },
          {
            icon: '💼',
            title: '$10k paper trading wallet',
            body: 'Every account starts with a $10,000 simulated wallet. Track open positions, unrealized P&L, and a full trade history. Reset anytime.',
          },
          {
            icon: '🤖',
            title: 'Execution agent',
            body: 'Define your trigger rules — confidence threshold, asset class, time window — and the agent places trades automatically via your connected broker API. Momentum tier.',
          },
          {
            icon: '📲',
            title: 'Instant alerts',
            body: 'Receive Telegram, email, or SMS notifications the moment a signal fires that matches your watchlist and confidence floor. Signal tier and above.',
          },
          {
            icon: '📚',
            title: 'Trading glossary',
            body: 'Every term Sigmentum uses — EMA, RSI, ATR, drawdown, Kelly sizing — explained in plain language with context from the signal feed. Linkable, searchable, SEO-indexed.',
            link: '/glossary',
            linkLabel: 'Browse the glossary →',
          },
        ].map(({ icon, title, body, link, linkLabel }) => (
          <div style="padding: 26px 28px; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--glass-bg-strong);">
            <div style="font-size: 26px; margin-bottom: 14px; line-height: 1;">{icon}</div>
            <h3 style="font-size: 16px; font-weight: 700; color: var(--ink); margin: 0 0 8px;">{title}</h3>
            <p style="font-size: 14px; color: var(--ink-3); line-height: 1.65; margin: 0 0 (link ? '14px' : '0');">{body}</p>
            {link && (
              <a href={link} style="font-size: 13px; color: var(--orange); font-weight: 500; text-decoration: none; display: inline-block; margin-top: 12px;">{linkLabel}</a>
            )}
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ── PRICING ────────────────────────────────────────────────────────── -->
  <section id="pricing" style="padding: 96px 0;">
    <div class="container" style="max-width: 960px;">

      <div style="text-align: center; margin-bottom: 56px;">
        <div class="eyebrow" style="margin-bottom: 12px;">The 2882 model</div>
        <h2 class="serif" style="font-size: clamp(28px, 4vw, 42px); font-weight: 700; margin: 0 0 16px; letter-spacing: -0.02em; color: var(--ink);">
          Simple pricing that scales with you
        </h2>
        <p style="font-size: 16px; color: var(--ink-3); max-width: 480px; margin: 0 auto;">
          Start free. Upgrade when you're ready to go live. Cancel anytime.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; align-items: start;">

        <!-- Free -->
        <div class="glass" style="padding: 32px 28px;">
          <div class="eyebrow" style="color: var(--ink-4); margin-bottom: 16px;">Free</div>
          <div style="font-size: 40px; font-weight: 800; color: var(--ink); letter-spacing: -0.03em; margin-bottom: 4px;">$0</div>
          <div style="font-size: 13px; color: var(--ink-4); margin-bottom: 28px;">per month · no card</div>
          <ul style="list-style: none; padding: 0; margin: 0 0 32px; display: flex; flex-direction: column; gap: 10px;">
            {['5 signals per day', '$10k paper trading wallet', '3 Hindsight backtests / month', 'Full AI reasoning on each signal', 'Trading glossary access'].map(f => (
              <li style="display: flex; gap: 10px; font-size: 14px; color: var(--ink-3);">
                <span style="color: var(--green); flex-shrink: 0; margin-top: 1px;">✓</span>
                {f}
              </li>
            ))}
          </ul>
          <a href={`${APP}${UTM}&utm_content=pricing_free`}
             style="display: block; text-align: center; padding: 12px 20px; border-radius: 999px; border: 1px solid var(--line-strong); font-size: 14px; font-weight: 500; color: var(--ink); text-decoration: none; transition: all 180ms;">
            Start free →
          </a>
        </div>

        <!-- Signal -->
        <div style="padding: 32px 28px; border-radius: var(--radius-lg); background: var(--ink); color: white; position: relative; overflow: hidden;">
          <div style="position: absolute; top: 0; right: 0; width: 120px; height: 120px; background: radial-gradient(circle, rgba(238,106,19,0.25), transparent); border-radius: 0 0 0 100%;"></div>
          <div class="eyebrow" style="color: rgba(255,255,255,0.5); margin-bottom: 16px;">Signal</div>
          <div style="font-size: 40px; font-weight: 800; color: white; letter-spacing: -0.03em; margin-bottom: 4px;">$28</div>
          <div style="font-size: 13px; color: rgba(255,255,255,0.45); margin-bottom: 28px;">per month</div>
          <ul style="list-style: none; padding: 0; margin: 0 0 32px; display: flex; flex-direction: column; gap: 10px;">
            {[
              'Everything in Free',
              'Unlimited signals, all assets',
              'Unlimited Hindsight backtests',
              'Telegram + email alerts',
              'Custom confidence threshold',
              'Priority signal delivery',
            ].map(f => (
              <li style="display: flex; gap: 10px; font-size: 14px; color: rgba(255,255,255,0.75);">
                <span style="color: var(--orange); flex-shrink: 0; margin-top: 1px;">✓</span>
                {f}
              </li>
            ))}
          </ul>
          <a href={`${APP}${UTM}&utm_content=pricing_signal`}
             style="display: block; text-align: center; padding: 12px 20px; border-radius: 999px; background: var(--orange); font-size: 14px; font-weight: 600; color: white; text-decoration: none; box-shadow: 0 4px 16px rgba(238,106,19,0.4); transition: all 180ms;">
            Get Signal →
          </a>
          <div style="text-align: center; margin-top: 12px; font-size: 11px; color: rgba(255,255,255,0.35);">Cancel anytime</div>
        </div>

        <!-- Momentum -->
        <div class="glass" style="padding: 32px 28px;">
          <div class="eyebrow" style="color: var(--ink-4); margin-bottom: 16px;">Momentum</div>
          <div style="font-size: 40px; font-weight: 800; color: var(--ink); letter-spacing: -0.03em; margin-bottom: 4px;">$82</div>
          <div style="font-size: 13px; color: var(--ink-4); margin-bottom: 28px;">per month</div>
          <ul style="list-style: none; padding: 0; margin: 0 0 32px; display: flex; flex-direction: column; gap: 10px;">
            {[
              'Everything in Signal',
              'Execution agent (auto-trades)',
              'Broker API integration',
              'Copy-agent marketplace access',
              'SMS alerts',
              'Dedicated support',
            ].map(f => (
              <li style="display: flex; gap: 10px; font-size: 14px; color: var(--ink-3);">
                <span style="color: var(--green); flex-shrink: 0; margin-top: 1px;">✓</span>
                {f}
              </li>
            ))}
          </ul>
          <a href={`${APP}${UTM}&utm_content=pricing_momentum`}
             style="display: block; text-align: center; padding: 12px 20px; border-radius: 999px; background: var(--ink); font-size: 14px; font-weight: 600; color: white; text-decoration: none; transition: all 180ms;">
            Get Momentum →
          </a>
        </div>

      </div>

      <p style="text-align: center; font-size: 12px; color: var(--ink-5); margin-top: 32px; line-height: 1.6;">
        Trading involves risk of loss. Sigmentum signals are informational only and do not constitute financial advice.<br/>Past signal performance is not indicative of future results.
      </p>

    </div>
  </section>

  <!-- ── CTA STRIP ─────────────────────────────────────────────────────── -->
  <section style="padding: 80px 0;">
    <div class="container" style="max-width: 640px; text-align: center;">
      <h2 class="serif" style="font-size: clamp(26px, 4vw, 38px); font-weight: 700; margin: 0 0 16px; letter-spacing: -0.02em; color: var(--ink);">
        Ready to trade with an AI edge?
      </h2>
      <p style="font-size: 16px; color: var(--ink-3); margin: 0 0 32px; line-height: 1.6;">
        Free account, $10k paper wallet, no credit card. Upgrade when the signals prove themselves.
      </p>
      <a href={`${APP}${UTM}&utm_content=bottom_cta`}
         style="display: inline-flex; align-items: center; gap: 8px; background: var(--orange); color: white; padding: 14px 32px; border-radius: 999px; font-size: 15px; font-weight: 600; text-decoration: none; box-shadow: 0 4px 20px rgba(238,106,19,0.35); transition: all 200ms;">
        Open Sigmentum free →
      </a>
      <div style="margin-top: 20px; font-size: 13px; color: var(--ink-5);">
        Explore the <a href="/glossary" style="color: var(--ink-4);">trading glossary</a> or <a href="#pricing" style="color: var(--ink-4);">compare plans</a>
      </div>
    </div>
  </section>

</Base>
