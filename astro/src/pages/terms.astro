---
import Base from '../layouts/Base.astro';

const siteUrl   = (Astro.site?.href ?? 'https://sigmentumtrade.com').replace(/\/$/, '');
const canonical = `${siteUrl}/terms`;
const title       = 'Terms of Service — Sigmentum';
const description = 'The terms governing use of Sigmentum. Signals are informational only and are not financial advice. Sigmentum does not place trades or manage money.';

const sections = [
  {
    h: 'Who we are',
    p: [
      'Sigmentum ("Sigmentum", "we", "us") is a product of 2882 LLC. These Terms of Service govern your access to and use of sigmentumtrade.com and any associated application, content or service (together, the "Service").',
      'By using the Service you agree to these terms. If you do not agree, do not use the Service.',
    ],
  },
  {
    h: 'What the Service is — and is not',
    p: [
      'Sigmentum publishes algorithmically generated, confidence-scored trading signals across crypto, foreign exchange, metals, energy and equity indices, together with a backtesting sandbox that runs user-written rules against historical price data.',
      'Everything the Service produces is informational and educational. It is not financial, investment, tax or legal advice, and it is not a recommendation, solicitation or offer to buy or sell any instrument. No content on the Service is personalised to your circumstances, objectives or risk tolerance.',
      'Sigmentum is not a broker-dealer, investment adviser, commodity trading advisor or fiduciary, and no advisory relationship is created by your use of the Service.',
    ],
    callout: 'Sigmentum does not place trades, does not connect to customer brokerage accounts, and does not manage money. Any automated order-placement or copy-agent functionality described on the Service as in development is not currently enabled on any tier.',
  },
  {
    h: 'Risk',
    p: [
      'Trading carries substantial risk, including total loss of capital. Leveraged instruments can produce losses exceeding your deposit. Past performance and backtested results do not predict future results, and backtests are hypothetical: they do not account for slippage, liquidity, fees or the behaviour of a live market.',
      'You are solely responsible for every decision you make and every order you place. You should consider obtaining advice from a licensed professional before trading.',
    ],
  },
  {
    h: 'Eligibility and accounts',
    p: [
      'You must be at least 18 years old and legally able to enter a contract. You are responsible for the accuracy of the information you give us, for keeping your credentials secure, and for all activity under your account.',
      'You may not use the Service where doing so would breach the law that applies to you. We may suspend or close an account that we reasonably believe is being used unlawfully or in breach of these terms.',
    ],
  },
  {
    h: 'Plans and billing',
    p: [
      'Sigmentum offers a Free tier and paid monthly plans — Signal at $28 per month and Momentum at $82 per month. Paid plans are billed in advance through Stripe, our payment processor. We do not receive or store your full card number.',
      'Paid plans renew automatically each month until cancelled. You can cancel at any time; cancellation stops future charges and your access continues to the end of the period you have already paid for. Partial months are not pro-rated.',
      'We may change prices with at least 30 days notice before the change applies to your next renewal. Refunds are governed by our Refunds & Cancellation policy.',
    ],
    link: { href: '/refunds', text: 'Read the Refunds & Cancellation policy' },
  },
  {
    h: 'Acceptable use',
    p: [
      'You may not scrape, crawl or bulk-extract the Service; resell, sublicense or redistribute signals or backtest output; reverse engineer the Service; interfere with its operation or security; or use it to build a competing product.',
      'You may use output for your own trading and may share individual results socially. You may not present Sigmentum output as your own analysis to paying third parties.',
    ],
  },
  {
    h: 'Third-party data',
    p: [
      'The Service depends on market data licensed from third-party providers. Some of that data is licensed for computation only and may not be displayed. Where a price cannot be shown, the Service says so rather than substituting an estimate.',
      'We do not warrant that third-party data is accurate, complete or uninterrupted, and we are not liable for provider errors, delays or outages.',
    ],
  },
  {
    h: 'Intellectual property',
    p: [
      'The Service, including its models, code, copy and brand, belongs to 2882 LLC. We grant you a limited, revocable, non-exclusive, non-transferable licence to use it for your own personal or internal business purposes while your account is in good standing. Rules and strategies you write in the sandbox remain yours.',
    ],
  },
  {
    h: 'Availability',
    p: [
      'The Service is provided on an "as is" and "as available" basis. We do not guarantee uninterrupted availability, and we may modify, suspend or discontinue any part of it. Features described as planned or in development may change or may never launch.',
    ],
  },
  {
    h: 'Disclaimers and limitation of liability',
    p: [
      'To the fullest extent permitted by law, we disclaim all warranties, express or implied, including merchantability, fitness for a particular purpose and non-infringement.',
      'To the fullest extent permitted by law, neither 2882 LLC nor its members, officers or contractors will be liable for any trading loss, lost profit, lost opportunity, or any indirect, incidental, special, consequential or punitive damages arising from your use of the Service. Our total aggregate liability for any claim is limited to the amount you paid us in the twelve months before the claim arose.',
      'Some jurisdictions do not allow certain exclusions; where that is the case, the exclusions apply to the maximum extent the law allows.',
    ],
  },
  {
    h: 'Indemnity',
    p: [
      'You agree to indemnify and hold harmless 2882 LLC against claims, losses and reasonable legal costs arising from your use of the Service, your breach of these terms, or your violation of any law or third-party right.',
    ],
  },
  {
    h: 'Termination',
    p: [
      'You may stop using the Service at any time. We may suspend or terminate access for breach of these terms, for unlawful use, or where required by a provider or regulator. Sections that by their nature should survive termination — including intellectual property, disclaimers, limitation of liability and indemnity — do survive.',
    ],
  },
  {
    h: 'Changes to these terms',
    p: [
      'We may update these terms. If a change is material we will give notice on the Service or by email before it takes effect. Continuing to use the Service after a change takes effect means you accept the updated terms.',
    ],
  },
  {
    h: 'Governing law',
    p: [
      'These terms are governed by the laws of the State of California, without regard to its conflict-of-laws rules. The state and federal courts located in California have exclusive jurisdiction over any dispute, and you and we each consent to that jurisdiction.',
    ],
  },
  {
    h: 'Contact',
    p: [
      'Questions about these terms go to support@sigmentumtrade.com.',
    ],
    link: { href: '/contact', text: 'Contact us' },
  },
];
---
<Base title={title} description={description} canonical={canonical}>
  <div class="container" style="padding-top: 56px; padding-bottom: 96px; max-width: 720px;">

    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <span style="color: var(--ink-3);">Terms of Service</span>
    </nav>

    <h1 class="serif" style="font-size: clamp(28px, 5vw, 44px); font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; color: var(--ink); margin: 0 0 8px;">
      Terms of Service
    </h1>
    <p style="font-size: 13px; color: var(--ink-4); margin: 0 0 48px;">
      Last updated: August 28, 2026 · Sigmentum, a product of 2882 LLC
    </p>

    <div style="display: flex; flex-direction: column; gap: 40px;">
      {sections.map(({ h, p, callout, link }) => (
        <div>
          <h2 style="font-size: 20px; font-weight: 700; color: var(--ink); margin: 0 0 12px; letter-spacing: -0.01em;">{h}</h2>
          {p.map(t => (
            <p style="font-size: 15px; color: var(--ink-3); line-height: 1.75; margin: 0 0 12px;">{t}</p>
          ))}
          {callout && (
            <div class="glass" style="padding: 20px 24px; margin-top: 4px;">
              <p style="font-size: 15px; color: var(--ink-2); line-height: 1.75; margin: 0; font-weight: 600;">{callout}</p>
            </div>
          )}
          {link && (
            <p style="font-size: 15px; line-height: 1.75; margin: 4px 0 0;">
              <a href={link.href}>{link.text}</a>
            </p>
          )}
        </div>
      ))}
    </div>

  </div>
</Base>
