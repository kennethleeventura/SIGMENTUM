{
  "name": "SIGMENTUM Blog Automation",
  "description": "Reads a queued blog topic from Google Sheets, generates a full article via GPT-4o, posts to Webflow CMS, and notifies Telegram.",
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:filterRows",
      "version": 2,
      "parameters": {
        "__IMTCONN__": "YOUR_GOOGLE_SHEETS_CONNECTION_ID"
      },
      "mapper": {
        "from": "drive",
        "limit": 1,
        "spreadsheetId": "YOUR_BLOG_QUEUE_SHEET_ID",
        "sheetId": "Queue",
        "includesHeaders": true,
        "tableFirstRow": "A1:F1",
        "filter": {
          "condition": {
            "a": "{{1.status}}",
            "b": "pending",
            "o": "equal"
          }
        },
        "orderBy": "submitted_date",
        "sortOrder": "asc",
        "valueRenderOption": "FORMATTED_VALUE",
        "dateTimeRenderOption": "FORMATTED_STRING"
      },
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "expect": [
          { "name": "topic",          "label": "Topic",          "type": "text" },
          { "name": "category",       "label": "Category",       "type": "text" },
          { "name": "target_keyword", "label": "Target Keyword", "type": "text" },
          { "name": "hook",           "label": "Hook",           "type": "text" },
          { "name": "submitted_date", "label": "Submitted Date", "type": "date" },
          { "name": "status",         "label": "Status",         "type": "text" }
        ]
      }
    },
    {
      "id": 2,
      "module": "openai-gpt-3:CreateCompletion",
      "version": 1,
      "parameters": {
        "__IMTCONN__": "YOUR_OPENAI_CONNECTION_ID"
      },
      "mapper": {
        "select": "chat",
        "model": "gpt-4o",
        "temperature": 0.6,
        "top_p": 1,
        "n_completions": 1,
        "max_tokens": 2000,
        "messages": [
          {
            "role": "system",
            "content": "You are the SIGMENTUM editorial AI. Write institutional-grade trading education content.\n\nReturn ONLY valid JSON — no markdown fences, no extra text. Response must start with { and end with }.\n\nSchema:\n{\n  \"title\": string,\n  \"hook\": string,\n  \"excerpt\": string,\n  \"read_time\": string,\n  \"body\": string,\n  \"slug\": string,\n  \"meta_description\": string,\n  \"tags\": string[]\n}\n\nRules:\n- title: compelling, specific, no clickbait. Max 80 chars.\n- hook: one punchy sentence ending with a question or sharp claim. Max 120 chars.\n- excerpt: 1-2 sentence summary for the blog card. Max 180 chars.\n- read_time: estimated read time, e.g. '6 min'\n- body: 600-900 words. 4-6 paragraphs. No markdown headers — plain paragraphs separated by \\n\\n. Bold key terms with **term**. Authoritative but readable. Reference Sigmentum features where relevant (confidence score, R:R, risk level, EMA stack).\n- slug: URL-safe lowercase hyphenated string from the title. Max 60 chars.\n- meta_description: SEO description 140-160 chars. Include target keyword naturally.\n- tags: 3-5 relevant tags as an array of strings."
          },
          {
            "role": "user",
            "content": "Write a blog article for SIGMENTUM.\n\nTopic: {{1.topic}}\nCategory: {{1.category}}\nTarget keyword: {{1.target_keyword}}\nHook (optional, use or improve): {{1.hook}}\n\nGenerate the JSON now."
          }
        ],
        "response_format": "json_object",
        "parseJSONResponse": true
      },
      "metadata": {
        "designer": { "x": 300, "y": 0 }
      }
    },
    {
      "id": 3,
      "module": "json:ParseJSON",
      "version": 1,
      "parameters": {},
      "mapper": {
        "json": "{{2.choices[].message.content}}"
      },
      "metadata": {
        "designer": { "x": 600, "y": 0 }
      }
    },
    {
      "id": 4,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": false,
        "useNewZLibDecompressor": true
      },
      "mapper": {
        "url": "https://api.webflow.com/v2/collections/YOUR_WEBFLOW_COLLECTION_ID/items",
        "serializeUrl": false,
        "method": "POST",
        "headers": [
          { "name": "Authorization", "value": "Bearer YOUR_WEBFLOW_API_TOKEN" },
          { "name": "Content-Type",  "value": "application/json" },
          { "name": "accept",        "value": "application/json" }
        ],
        "qs": [],
        "bodyType": "raw",
        "parseResponse": true,
        "authUser": "",
        "authPass": "",
        "timeout": "",
        "shareCookies": false,
        "ca": "",
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "contentType": "application/json",
        "body": "{\"isArchived\":false,\"isDraft\":false,\"fieldData\":{\"name\":\"{{3.title}}\",\"slug\":\"{{3.slug}}\",\"excerpt\":\"{{3.excerpt}}\",\"hook\":\"{{3.hook}}\",\"body\":\"{{3.body}}\",\"category\":\"{{1.category}}\",\"read-time\":\"{{3.read_time}}\",\"meta-description\":\"{{3.meta_description}}\",\"tags\":{{3.tags}},\"published-on\":\"{{now}}\",\"auto-generated\":true}}"
      },
      "metadata": {
        "designer": { "x": 900, "y": 0 }
      }
    },
    {
      "id": 5,
      "module": "google-sheets:updateRow",
      "version": 2,
      "parameters": {
        "__IMTCONN__": "YOUR_GOOGLE_SHEETS_CONNECTION_ID"
      },
      "mapper": {
        "from": "drive",
        "spreadsheetId": "YOUR_BLOG_QUEUE_SHEET_ID",
        "sheetId": "Queue",
        "includesHeaders": true,
        "tableFirstRow": "A1:F1",
        "rowNumber": "{{1.__ROW_NUMBER__}}",
        "values": {
          "status": "published",
          "published_date": "{{formatDate(now; 'YYYY-MM-DD')}}",
          "webflow_item_id": "{{4.data.id}}",
          "webflow_url": "https://sigmentum.com/learn/{{3.slug}}"
        }
      },
      "metadata": {
        "designer": { "x": 1200, "y": 0 }
      }
    },
    {
      "id": 6,
      "module": "telegram-bot-api:sendMessage",
      "version": 1,
      "parameters": {
        "__IMTCONN__": "YOUR_TELEGRAM_BOT_CONNECTION_ID"
      },
      "mapper": {
        "chat_id": "YOUR_TELEGRAM_CHANNEL_ID",
        "text": "📚 *New article published*\n\n*{{3.title}}*\n\n_{{3.hook}}_\n\n{{3.excerpt}}\n\n🔗 [Read now](https://sigmentum.com/learn/{{3.slug}})\n\n🏷 {{join(3.tags; ' · ')}}",
        "parse_mode": "Markdown",
        "disable_web_page_preview": false,
        "disable_notification": false
      },
      "metadata": {
        "designer": { "x": 1500, "y": 0 }
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "eu1.make.com"
  },
  "_setup": {
    "google_sheets_columns": {
      "A": "topic",
      "B": "category",
      "C": "target_keyword",
      "D": "hook",
      "E": "submitted_date",
      "F": "status",
      "G": "published_date",
      "H": "webflow_item_id",
      "I": "webflow_url"
    },
    "categories": ["Market Structure", "Risk", "Systems", "Education", "Psychology"],
    "webflow_required_fields": ["name", "slug", "excerpt", "hook", "body", "category", "read-time", "meta-description", "auto-generated"],
    "schedule_recommendation": "daily at 07:00 UTC",
    "placeholders_to_replace": [
      "YOUR_GOOGLE_SHEETS_CONNECTION_ID",
      "YOUR_OPENAI_CONNECTION_ID",
      "YOUR_BLOG_QUEUE_SHEET_ID",
      "YOUR_WEBFLOW_COLLECTION_ID",
      "YOUR_WEBFLOW_API_TOKEN",
      "YOUR_TELEGRAM_BOT_CONNECTION_ID",
      "YOUR_TELEGRAM_CHANNEL_ID"
    ]
  }
}
